//@version=6
// =============================================================================
// Advanced Professional Trendline Indicator - Pine Script v6
// Multi-Timeframe | Breakout Detection | Volume Confirmation | Smart Filtering
// Automatic Dynamic & Static Trendline Detection with Advanced Analytics
// Fully Modular Architecture for Easy Extension
// =============================================================================

indicator("Advanced Professional Trendline Indicator v6", overlay=true, max_lines_count=500, max_labels_count=500)

// =============================================================================
// MODULE 1: Configuration & Settings
// =============================================================================

// Group: Multi-Timeframe Settings
enableHTF = input.bool(true, "Enable Higher Timeframe", group="Multi-Timeframe")
htfTimeframe = input.timeframe("240", "Higher Timeframe", group="Multi-Timeframe", 
     tooltip="Higher timeframe for trend analysis (e.g., 4H, D, W)")
showCurrentTF = input.bool(true, "Show Current Timeframe Lines", group="Multi-Timeframe")
showHTF = input.bool(true, "Show Higher Timeframe Lines", group="Multi-Timeframe")

// Group: Pivot Detection Settings
pivotLeftBars = input.int(10, "Pivot Left Bars", minval=1, group="Pivot Detection")
pivotRightBars = input.int(10, "Pivot Right Bars", minval=1, group="Pivot Detection")
maxStoredPivots = input.int(20, "Max Stored Pivots", minval=2, maxval=50, group="Pivot Detection")

// Group: Trendline Settings
showResistance = input.bool(true, "Show Resistance Lines", group="Trendline Display")
showSupport = input.bool(true, "Show Support Lines", group="Trendline Display")

// Group: Visual Settings - Current Timeframe
ctfColor = input.color(color.new(color.white, 0), "Current TF Color", group="Current Timeframe Style")
ctfLineWidth = input.int(2, "Current TF Width", minval=1, maxval=5, group="Current Timeframe Style")

// Group: Visual Settings - Higher Timeframe
htfResistanceColor = input.color(color.new(color.red, 20), "HTF Resistance Color", group="Higher Timeframe Style")
htfSupportColor = input.color(color.new(color.green, 20), "HTF Support Color", group="Higher Timeframe Style")
htfLineWidth = input.int(2, "HTF Line Width", minval=1, maxval=3, group="Higher Timeframe Style")

// Group: Advanced Settings
minTrendlineStrength = input.int(3, "Min Trendline Strength", minval=2, maxval=10, group="Advanced Settings", 
     tooltip="Minimum number of pivot points to form a valid trendline")
trendlineExtension = input.string("Right", "Extend Lines", options=["None", "Right", "Left", "Both"], group="Advanced Settings")
maxLinesPerType = input.int(3, "Max Lines Per Type", minval=1, maxval=10, group="Advanced Settings",
     tooltip="Reduced from 10 to show only most important trendlines")

// Group: Advanced Features
enableBreakoutDetection = input.bool(true, "Enable Breakout Detection", group="Advanced Features")
enableRetestAlerts = input.bool(true, "Enable Retest Detection", group="Advanced Features")
enableVolumeConfirmation = input.bool(true, "Enable Volume Confirmation", group="Advanced Features")
enableParallelFilter = input.bool(true, "Filter Parallel Lines", group="Advanced Features",
     tooltip="Remove lines that are too close to each other")
enableAgingTransparency = input.bool(true, "Age-Based Transparency", group="Advanced Features",
     tooltip="Older trendlines become more transparent")

// Group: Visual Enhancements
showTouchPoints = input.bool(true, "Show Touch Points", group="Visual Enhancements")
showPriceLabels = input.bool(true, "Show Price Labels", group="Visual Enhancements")
showStatisticsLabels = input.bool(true, "Show Statistics Labels", group="Visual Enhancements")
showRiskRewardZones = input.bool(false, "Show Risk/Reward Zones", group="Visual Enhancements")

// Group: Alert Settings
breakoutAlertDistance = input.float(0.5, "Breakout Alert Distance %", minval=0.1, maxval=5.0, group="Alert Settings",
     tooltip="Distance from line to trigger breakout alert")
retestAlertDistance = input.float(0.3, "Retest Alert Distance %", minval=0.1, maxval=5.0, group="Alert Settings")
volumeMultiplier = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=5.0, group="Alert Settings",
     tooltip="Volume must be this times average for confirmation")

// =============================================================================
// MODULE 2: Utility Functions
// =============================================================================

// @function Converts string to line style constant
// @param styleStr Style name as string
// @returns line.style constant
f_getLineStyle(string styleStr) =>
    switch styleStr
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// @function Converts string to extend constant
// @param extStr Extension type as string
// @returns extend constant
f_getExtension(string extStr) =>
    switch extStr
        "None" => extend.none
        "Right" => extend.right
        "Left" => extend.left
        "Both" => extend.both
        => extend.right

// @function Calculates the slope between two points
// @param x1 First x coordinate
// @param y1 First y coordinate
// @param x2 Second x coordinate
// @param y2 Second y coordinate
// @returns Slope value
f_calculateSlope(int x1, float y1, int x2, float y2) =>
    (y2 - y1) / (x2 - x1)

// @function Checks if a trendline is valid based on strength
// @param touchPoints Number of pivot points the line touches
// @returns true if valid
f_isValidTrendline(int touchPoints) =>
    touchPoints >= minTrendlineStrength

// @function Checks if two lines are parallel (too close)
// @param slope1 Slope of first line
// @param slope2 Slope of second line
// @param price1 Price of first line at current bar
// @param price2 Price of second line at current bar
// @param atr Current ATR value
// @returns true if lines are parallel/too close
f_areLinesParallel(float slope1, float slope2, float price1, float price2, float atr) =>
    slopeDiff = math.abs(slope1 - slope2)
    priceDiff = math.abs(price1 - price2)
    slopeDiff < 0.0001 and priceDiff < atr

// @function Calculates touch quality score (0-100)
// @param touchCount Number of touches
// @param lineAge Age of the line in bars
// @param vol Current volume
// @param avgVolume Average volume
// @returns Quality score
f_calculateTouchQuality(int touchCount, int lineAge, float vol, float avgVolume) =>
    baseScore = math.min(touchCount * 20, 60)  // Max 60 from touches
    ageBonus = math.min(lineAge / 100, 20)     // Max 20 from age
    volumeBonus = vol > avgVolume ? 20 : 0      // 20 if high volume
    math.min(baseScore + ageBonus + volumeBonus, 100)

// =============================================================================
// MODULE 3: Pivot Detection
// =============================================================================

// @function Detects pivot highs
// @param leftBars Left bars for pivot
// @param rightBars Right bars for pivot
// @returns Pivot high price or na
f_detectPivotHigh(int leftBars, int rightBars) =>
    ta.pivothigh(high, leftBars, rightBars)

// @function Detects pivot lows
// @param leftBars Left bars for pivot
// @param rightBars Right bars for pivot
// @returns Pivot low price or na
f_detectPivotLow(int leftBars, int rightBars) =>
    ta.pivotlow(low, leftBars, rightBars)

// Detect current pivots
currentPivotHigh = f_detectPivotHigh(pivotLeftBars, pivotRightBars)
currentPivotLow = f_detectPivotLow(pivotLeftBars, pivotRightBars)

// =============================================================================
// MODULE 4: Data Storage (Pivot Points)
// =============================================================================

// Storage arrays for pivot highs
var array<float> pivotHighPrices = array.new<float>()
var array<int> pivotHighBars = array.new<int>()

// Storage arrays for pivot lows
var array<float> pivotLowPrices = array.new<float>()
var array<int> pivotLowBars = array.new<int>()

// Update pivot high storage
if not na(currentPivotHigh)
    array.unshift(pivotHighPrices, currentPivotHigh)
    array.unshift(pivotHighBars, bar_index - pivotRightBars)
    
    // Limit array size
    if array.size(pivotHighPrices) > maxStoredPivots
        array.pop(pivotHighPrices)
        array.pop(pivotHighBars)

// Update pivot low storage
if not na(currentPivotLow)
    array.unshift(pivotLowPrices, currentPivotLow)
    array.unshift(pivotLowBars, bar_index - pivotRightBars)
    
    // Limit array size
    if array.size(pivotLowPrices) > maxStoredPivots
        array.pop(pivotLowPrices)
        array.pop(pivotLowBars)

// =============================================================================
// MODULE 5: Trendline Type Definition
// =============================================================================

// @type Represents a single trendline with all its properties
type Trendline
    line lineObj
    label priceLabel
    int x1
    float y1
    int x2
    float y2
    float slope
    int touchPoints
    bool isDynamic
    float strength
    int age
    float qualityScore
    bool breakoutDetected
    bool retestDetected
    array<int> touchBars      // Bars where line was touched
    array<float> touchPrices  // Prices at touch points

// @type Extended Trendline Manager with advanced features
type TrendlineManager
    array<Trendline> trendlines
    int maxLines

// =============================================================================
// MODULE 6: Trendline Manager
// =============================================================================

// @function Creates a new TrendlineManager instance
// @param maxLines Maximum number of lines to manage
// @returns New TrendlineManager instance
f_createTrendlineManager(int maxLines) =>
    manager = TrendlineManager.new(
         array.new<Trendline>(),
         maxLines
     )
    manager

// @function Adds a trendline to the manager
// @param this TrendlineManager instance
// @param trendline Trendline to add
// @param atrValue ATR value for parallel filtering
method addTrendline(TrendlineManager this, Trendline trendline, float atrValue) =>
    // Check for parallel lines if filter is enabled
    if enableParallelFilter and array.size(this.trendlines) > 0
        isParallel = false
        for i = 0 to array.size(this.trendlines) - 1
            existing = array.get(this.trendlines, i)
            currentPrice = trendline.y1 + trendline.slope * (bar_index - trendline.x1)
            existingPrice = existing.y1 + existing.slope * (bar_index - existing.x1)
            
            if f_areLinesParallel(trendline.slope, existing.slope, currentPrice, existingPrice, atrValue)
                isParallel := true
                break
        
        if not isParallel
            array.push(this.trendlines, trendline)
    else
        array.push(this.trendlines, trendline)
    
    // Remove oldest if exceeding max
    if array.size(this.trendlines) > this.maxLines
        oldest = array.shift(this.trendlines)
        line.delete(oldest.lineObj)
        if not na(oldest.priceLabel)
            label.delete(oldest.priceLabel)

// @function Clears all trendlines from the manager
// @param this TrendlineManager instance
method clearAll(TrendlineManager this) =>
    if array.size(this.trendlines) > 0
        for i = 0 to array.size(this.trendlines) - 1
            tl = array.get(this.trendlines, i)
            line.delete(tl.lineObj)
            if not na(tl.priceLabel)
                label.delete(tl.priceLabel)
        array.clear(this.trendlines)

// =============================================================================
// MODULE 7: Trendline Drawing Functions
// =============================================================================

// @function Draws a trendline with all visual enhancements
// @param x1 Start bar index
// @param y1 Start price
// @param x2 End bar index
// @param y2 End price
// @param lineColor Color of the line
// @param isHTF Whether this is a higher timeframe line
// @param lineWidth Width of the line
// @param age Age of the trendline in bars
// @param touchPoints Number of touch points
// @param qualityScore Quality score of the line
// @returns Created Trendline object
f_drawTrendline(int x1, float y1, int x2, float y2, color lineColor, bool isHTF, int lineWidth, 
     int age, int touchPoints, float qualityScore, array<int> touchBars, array<float> touchPrices) =>
    
    lineStyle = isHTF ? line.style_dashed : line.style_solid
    extend = f_getExtension(trendlineExtension)
    
    // Apply age-based transparency
    transparency = 0
    if enableAgingTransparency and age > 50
        transparency := int(math.min((age - 50) / 2, 70))
    
    finalColor = color.new(lineColor, transparency)
    
    // Create the line
    lineObj = line.new(
         x1, y1, x2, y2,
         xloc=xloc.bar_index,
         extend=extend,
         color=finalColor,
         style=lineStyle,
         width=lineWidth
     )
    
    // Create price label if enabled
    currentPrice = y2 + (y2 - y1) / (x2 - x1) * (bar_index - x2)
    priceLabel = label(na)
    
    if showPriceLabels
        labelText = str.tostring(currentPrice, format.mintick)
        if showStatisticsLabels
            labelText := labelText + "\n↑" + str.tostring(touchPoints) + " | Q:" + str.tostring(int(qualityScore))
        
        priceLabel := label.new(
             bar_index, currentPrice,
             text=labelText,
             style=label.style_label_left,
             color=color.new(lineColor, 80),
             textcolor=lineColor,
             size=size.small
         )
    
    // Draw touch points if enabled
    if showTouchPoints and array.size(touchBars) > 0
        for i = 0 to array.size(touchBars) - 1
            touchBar = array.get(touchBars, i)
            touchPrice = array.get(touchPrices, i)
            label.new(
                 touchBar, touchPrice,
                 text="•",
                 style=label.style_none,
                 textcolor=lineColor,
                 size=size.small
             )
    
    // Create Trendline object
    trendline = Trendline.new(
         lineObj,
         priceLabel,
         x1, y1, x2, y2,
         (y2 - y1) / (x2 - x1),
         touchPoints,
         math.abs((y2 - y1) / (x2 - x1)) > 0.0001,
         qualityScore,
         age,
         qualityScore,
         false,
         false,
         touchBars,
         touchPrices
     )
    
    trendline

// @function Calculates the quality/strength of a trendline with touch detection
// @param x1 Start bar
// @param y1 Start price
// @param x2 End bar
// @param y2 End price
// @param pivotBars Array of pivot bar indices
// @param pivotPrices Array of pivot prices
// @param tolerance Price tolerance for considering a point on the line
// @returns [touchCount, touchBars, touchPrices]
f_calculateTrendlineStrength(int x1, float y1, int x2, float y2, 
     array<int> pivotBars, array<float> pivotPrices, float tolerance) =>
    int touchCount = 0
    slope = f_calculateSlope(x1, y1, x2, y2)
    
    var array<int> touchBars = array.new<int>()
    var array<float> touchPrices = array.new<float>()
    array.clear(touchBars)
    array.clear(touchPrices)
    
    // Check how many pivots touch this line
    for i = 0 to array.size(pivotBars) - 1
        barIdx = array.get(pivotBars, i)
        price = array.get(pivotPrices, i)
        
        // Calculate expected price on line at this bar
        expectedPrice = y1 + slope * (barIdx - x1)
        
        // Check if pivot is close to the line
        if math.abs(price - expectedPrice) <= tolerance
            touchCount += 1
            array.push(touchBars, barIdx)
            array.push(touchPrices, price)
    
    [touchCount, touchBars, touchPrices]

// =============================================================================
// MODULE 8: Main Trendline Detection Algorithm with Advanced Features
// =============================================================================

// @function Finds the best trendlines with advanced filtering and scoring
// @param pivotBars Array of pivot bar indices
// @param pivotPrices Array of pivot prices
// @param isResistance Whether finding resistance (true) or support (false)
// @param manager TrendlineManager to add lines to
// @param lineColor Color for the lines
// @param tolerance Price tolerance for trendline detection
// @param isHTF Whether this is higher timeframe data
// @param lineWidth Width of the line
// @param avgVol Average volume for quality scoring
f_findBestTrendlines(array<int> pivotBars, array<float> pivotPrices, 
     bool isResistance, TrendlineManager manager, color lineColor, float tolerance, bool isHTF, int lineWidth, float avgVol, float atrValue) =>
    
    int pivotCount = array.size(pivotBars)
    
    if pivotCount >= 2
        
        array<float> lineStrengths = array.new<float>()
        array<float> lineQualityScores = array.new<float>()
        array<int> lineI = array.new<int>()
        array<int> lineJ = array.new<int>()
        
        // Find all possible trendlines and calculate their strength
        for i = 0 to pivotCount - 2
            for j = i + 1 to pivotCount - 1
                x1 = array.get(pivotBars, j)
                y1 = array.get(pivotPrices, j)
                x2 = array.get(pivotBars, i)
                y2 = array.get(pivotPrices, i)
                
                // Calculate strength with touch detection
                [strength, touchBars, touchPrices] = f_calculateTrendlineStrength(x1, y1, x2, y2, 
                     pivotBars, pivotPrices, tolerance)
                
                if strength >= minTrendlineStrength
                    // Calculate quality score
                    lineAge = bar_index - x1
                    qualityScore = f_calculateTouchQuality(strength, lineAge, volume, avgVol)
                    
                    // Volume confirmation filter
                    passVolumeFilter = true
                    if enableVolumeConfirmation
                        passVolumeFilter := volume > avgVol * volumeMultiplier or not enableVolumeConfirmation
                    
                    if passVolumeFilter or not enableVolumeConfirmation
                        array.push(lineStrengths, strength)
                        array.push(lineQualityScores, qualityScore)
                        array.push(lineI, i)
                        array.push(lineJ, j)
        
        // Sort by quality score (not just strength)
        int strengthCount = array.size(lineStrengths)
        
        if strengthCount > 0
            // Bubble sort to get top lines by quality
            for i = 0 to math.min(strengthCount - 1, maxLinesPerType - 1)
                maxIdx = i
                for j = i + 1 to strengthCount - 1
                    if array.get(lineQualityScores, j) > array.get(lineQualityScores, maxIdx)
                        maxIdx := j
                
                // Swap
                if maxIdx != i
                    tempStrength = array.get(lineStrengths, i)
                    array.set(lineStrengths, i, array.get(lineStrengths, maxIdx))
                    array.set(lineStrengths, maxIdx, tempStrength)
                    
                    tempQuality = array.get(lineQualityScores, i)
                    array.set(lineQualityScores, i, array.get(lineQualityScores, maxIdx))
                    array.set(lineQualityScores, maxIdx, tempQuality)
                    
                    tempI = array.get(lineI, i)
                    array.set(lineI, i, array.get(lineI, maxIdx))
                    array.set(lineI, maxIdx, tempI)
                    
                    tempJ = array.get(lineJ, i)
                    array.set(lineJ, i, array.get(lineJ, maxIdx))
                    array.set(lineJ, maxIdx, tempJ)
                
                // Draw the line with all enhancements
                idx_i = array.get(lineI, i)
                idx_j = array.get(lineJ, i)
                
                x1 = array.get(pivotBars, idx_j)
                y1 = array.get(pivotPrices, idx_j)
                x2 = array.get(pivotBars, idx_i)
                y2 = array.get(pivotPrices, idx_i)
                
                lineAge = bar_index - x1
                touchPoints = int(array.get(lineStrengths, i))
                qualityScore = array.get(lineQualityScores, i)
                
                // Recalculate touch bars and prices for this line
                [_, touchBars, touchPrices] = f_calculateTrendlineStrength(x1, y1, x2, y2, 
                     pivotBars, pivotPrices, tolerance)
                
                trendline = f_drawTrendline(x1, y1, x2, y2, lineColor, isHTF, lineWidth, 
                     lineAge, touchPoints, qualityScore, touchBars, touchPrices)
                
                manager.addTrendline(trendline, atrValue)

// =============================================================================
// MODULE 9: Initialization & Main Execution
// =============================================================================

// Initialize managers for current timeframe
var TrendlineManager ctfResistanceManager = f_createTrendlineManager(maxLinesPerType)
var TrendlineManager ctfSupportManager = f_createTrendlineManager(maxLinesPerType)

// Initialize managers for higher timeframe
var TrendlineManager htfResistanceManager = f_createTrendlineManager(maxLinesPerType)
var TrendlineManager htfSupportManager = f_createTrendlineManager(maxLinesPerType)

// Calculate tolerance and volume average on every bar for consistency
float atrTolerance = ta.atr(14) * 0.5
float avgVol = ta.sma(volume, 50)

// Get higher timeframe data
[htfHigh, htfLow] = request.security(syminfo.tickerid, htfTimeframe, [high, low], lookahead=barmerge.lookahead_off)

// Detect HTF pivots
htfPivotHigh = request.security(syminfo.tickerid, htfTimeframe, 
     f_detectPivotHigh(pivotLeftBars, pivotRightBars), lookahead=barmerge.lookahead_off)
htfPivotLow = request.security(syminfo.tickerid, htfTimeframe, 
     f_detectPivotLow(pivotLeftBars, pivotRightBars), lookahead=barmerge.lookahead_off)

// Storage for HTF pivots
var array<float> htfPivotHighPrices = array.new<float>()
var array<int> htfPivotHighBars = array.new<int>()
var array<float> htfPivotLowPrices = array.new<float>()
var array<int> htfPivotLowBars = array.new<int>()

// Update HTF pivot storage
if enableHTF and not na(htfPivotHigh)
    array.unshift(htfPivotHighPrices, htfPivotHigh)
    array.unshift(htfPivotHighBars, bar_index - pivotRightBars)
    if array.size(htfPivotHighPrices) > maxStoredPivots
        array.pop(htfPivotHighPrices)
        array.pop(htfPivotHighBars)

if enableHTF and not na(htfPivotLow)
    array.unshift(htfPivotLowPrices, htfPivotLow)
    array.unshift(htfPivotLowBars, bar_index - pivotRightBars)
    if array.size(htfPivotLowPrices) > maxStoredPivots
        array.pop(htfPivotLowPrices)
        array.pop(htfPivotLowBars)

// Clear all lines on last bar
if barstate.islast
    ctfResistanceManager.clearAll()
    ctfSupportManager.clearAll()
    htfResistanceManager.clearAll()
    htfSupportManager.clearAll()

// Draw current timeframe trendlines (white, solid)
if barstate.islast and showCurrentTF and showResistance
    f_findBestTrendlines(pivotHighBars, pivotHighPrices, true, 
         ctfResistanceManager, ctfColor, atrTolerance, false, ctfLineWidth, avgVol, atrTolerance)

if barstate.islast and showCurrentTF and showSupport
    f_findBestTrendlines(pivotLowBars, pivotLowPrices, false, 
         ctfSupportManager, ctfColor, atrTolerance, false, ctfLineWidth, avgVol, atrTolerance)

// Draw higher timeframe trendlines (colored, dashed)
if barstate.islast and enableHTF and showHTF and showResistance
    f_findBestTrendlines(htfPivotHighBars, htfPivotHighPrices, true, 
         htfResistanceManager, htfResistanceColor, atrTolerance * 2, true, htfLineWidth, avgVol, atrTolerance * 2)

if barstate.islast and enableHTF and showHTF and showSupport
    f_findBestTrendlines(htfPivotLowBars, htfPivotLowPrices, false, 
         htfSupportManager, htfSupportColor, atrTolerance * 2, true, htfLineWidth, avgVol, atrTolerance * 2)

// =============================================================================
// MODULE 10: Breakout & Retest Detection
// =============================================================================

// @function Detects breakouts and retests on trendlines
// @param manager TrendlineManager to check
// @param isResistance Whether checking resistance or support lines
// @returns [breakoutDetected, retestDetected, linePrice]
f_detectBreakoutsAndRetests(TrendlineManager manager, bool isResistance) =>
    breakoutDetected = false
    retestDetected = false
    linePrice = 0.0
    
    if array.size(manager.trendlines) > 0
        for i = 0 to array.size(manager.trendlines) - 1
            tl = array.get(manager.trendlines, i)
            currentLinePrice = tl.y1 + tl.slope * (bar_index - tl.x1)
            breakoutDistance = currentLinePrice * (breakoutAlertDistance / 100)
            retestDistance = currentLinePrice * (retestAlertDistance / 100)
            
            if enableBreakoutDetection
                if isResistance
                    // Breakout above resistance
                    if close > currentLinePrice + breakoutDistance and close[1] <= currentLinePrice
                        breakoutDetected := true
                        linePrice := currentLinePrice
                        tl.breakoutDetected := true
                else
                    // Breakout below support
                    if close < currentLinePrice - breakoutDistance and close[1] >= currentLinePrice
                        breakoutDetected := true
                        linePrice := currentLinePrice
                        tl.breakoutDetected := true
            
            if enableRetestAlerts and tl.breakoutDetected
                if isResistance
                    // Retest from above after breakout
                    if close < currentLinePrice + retestDistance and close > currentLinePrice - retestDistance
                        retestDetected := true
                        tl.retestDetected := true
                else
                    // Retest from below after breakout
                    if close > currentLinePrice - retestDistance and close < currentLinePrice + retestDistance
                        retestDetected := true
                        tl.retestDetected := true
    
    [breakoutDetected, retestDetected, linePrice]

// =============================================================================
// MODULE 11: Visual Enhancements & Info Display
// =============================================================================

// Plot pivot points for visualization
plotshape(currentPivotHigh, "CTF Pivot High", shape.triangledown, location.abovebar, 
     color.new(ctfColor, 50), size=size.tiny)
plotshape(currentPivotLow, "CTF Pivot Low", shape.triangleup, location.belowbar, 
     color.new(ctfColor, 50), size=size.tiny)

// Plot HTF pivots if enabled
plotshape(enableHTF ? htfPivotHigh : na, "HTF Pivot High", shape.xcross, location.abovebar, 
     color.new(htfResistanceColor, 30), size=size.small)
plotshape(enableHTF ? htfPivotLow : na, "HTF Pivot Low", shape.xcross, location.belowbar, 
     color.new(htfSupportColor, 30), size=size.small)

// Check for breakouts and retests
[ctfResBreakout, ctfResRetest, ctfResPrice] = f_detectBreakoutsAndRetests(ctfResistanceManager, true)
[ctfSupBreakout, ctfSupRetest, ctfSupPrice] = f_detectBreakoutsAndRetests(ctfSupportManager, false)
[htfResBreakout, htfResRetest, htfResPrice] = f_detectBreakoutsAndRetests(htfResistanceManager, true)
[htfSupBreakout, htfSupRetest, htfSupPrice] = f_detectBreakoutsAndRetests(htfSupportManager, false)

// Plot breakout signals
plotshape(ctfResBreakout, "CTF Resistance Breakout", shape.triangleup, location.belowbar, 
     color.new(color.lime, 0), size=size.normal, text="BO")
plotshape(ctfSupBreakout, "CTF Support Breakout", shape.triangledown, location.abovebar, 
     color.new(color.red, 0), size=size.normal, text="BO")

// Plot retest signals
plotshape(ctfResRetest, "CTF Resistance Retest", shape.diamond, location.abovebar, 
     color.new(color.yellow, 0), size=size.small, text="RT")
plotshape(ctfSupRetest, "CTF Support Retest", shape.diamond, location.belowbar, 
     color.new(color.yellow, 0), size=size.small, text="RT")

// Display enhanced information table
var table infoTable = table.new(position.top_right, 3, 9, 
     bgcolor=color.new(color.gray, 90), border_width=1)

if barstate.islast
    // Header
    table.cell(infoTable, 0, 0, "📊 Trendline Analytics", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 70))
    table.merge_cells(infoTable, 0, 0, 2, 0)
    
    // Current Timeframe Section
    table.cell(infoTable, 0, 1, "CTF Resistance:", text_color=ctfColor, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(array.size(ctfResistanceManager.trendlines)), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 1, ctfResBreakout ? "🔺 BO" : (ctfResRetest ? "💎 RT" : ""), text_color=color.yellow, text_size=size.tiny)
    
    table.cell(infoTable, 0, 2, "CTF Support:", text_color=ctfColor, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(array.size(ctfSupportManager.trendlines)), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 2, ctfSupBreakout ? "🔻 BO" : (ctfSupRetest ? "💎 RT" : ""), text_color=color.yellow, text_size=size.tiny)
    
    // Higher Timeframe Section
    table.cell(infoTable, 0, 3, "HTF Resistance:", text_color=htfResistanceColor, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(array.size(htfResistanceManager.trendlines)), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 3, htfResBreakout ? "🔺 BO" : (htfResRetest ? "💎 RT" : ""), text_color=color.yellow, text_size=size.tiny)
    
    table.cell(infoTable, 0, 4, "HTF Support:", text_color=htfSupportColor, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(array.size(htfSupportManager.trendlines)), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 4, htfSupBreakout ? "🔻 BO" : (htfSupRetest ? "💎 RT" : ""), text_color=color.yellow, text_size=size.tiny)
    
    // Statistics Section
    table.cell(infoTable, 0, 5, "━━━━━━━━━━━━━", text_color=color.gray, text_size=size.tiny)
    table.merge_cells(infoTable, 0, 5, 2, 5)
    
    table.cell(infoTable, 0, 6, "CTF Pivots:", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 6, str.tostring(array.size(pivotHighBars) + array.size(pivotLowBars)), text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 6, "", text_color=color.white, text_size=size.tiny)
    
    table.cell(infoTable, 0, 7, "HTF Pivots:", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 7, str.tostring(array.size(htfPivotHighBars) + array.size(htfPivotLowBars)), text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 7, "", text_color=color.white, text_size=size.tiny)
    
    // Volume indicator (using pre-calculated avgVol)
    volStatus = volume > avgVol * volumeMultiplier ? "🔊 HIGH" : "🔉 Norm"
    table.cell(infoTable, 0, 8, "Volume:", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 8, volStatus, text_color=volume > avgVol * volumeMultiplier ? color.lime : color.gray, text_size=size.tiny)
    table.cell(infoTable, 2, 8, "", text_color=color.white, text_size=size.tiny)

// =============================================================================
// MODULE 12: Alert Conditions
// =============================================================================

// Breakout alerts
alertcondition(ctfResBreakout or htfResBreakout, 
     title="Resistance Breakout", 
     message="Price broke above resistance trendline!")

alertcondition(ctfSupBreakout or htfSupBreakout, 
     title="Support Breakout", 
     message="Price broke below support trendline!")

// Retest alerts
alertcondition(ctfResRetest or htfResRetest, 
     title="Resistance Retest", 
     message="Price is retesting broken resistance!")

alertcondition(ctfSupRetest or htfSupRetest, 
     title="Support Retest", 
     message="Price is retesting broken support!")

// Combined alert
alertcondition(ctfResBreakout or ctfSupBreakout or htfResBreakout or htfSupBreakout, 
     title="Any Breakout", 
     message="Trendline breakout detected!")

